digraph G { graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.8, splines=polyline]; node [shape=plain,fontname="Arial"]; edge [color="#64748b",arrowsize=0.65];
"_prisma_migrations" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#16324f"><FONT COLOR="white"><B>_prisma_migrations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="10">PK id : varchar(36)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="checksum"><FONT POINT-SIZE="10">checksum : varchar(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="finished_at"><FONT POINT-SIZE="10">finished_at : datetime(3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="migration_name"><FONT POINT-SIZE="10">migration_name : varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="logs"><FONT POINT-SIZE="10">logs : text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rolled_back_at"><FONT POINT-SIZE="10">rolled_back_at : datetime(3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="started_at"><FONT POINT-SIZE="10">started_at : datetime(3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="applied_steps_count"><FONT POINT-SIZE="10">applied_steps_count : int unsigned</FONT></TD></TR></TABLE>>];
"advisor_student" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#16324f"><FONT COLOR="white"><B>advisor_student</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="10">PK id : bigint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="advisor_code"><FONT POINT-SIZE="10">advisor_code : varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="student_code"><FONT POINT-SIZE="10">student_code : varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="department"><FONT POINT-SIZE="10">department : varchar(255)</FONT></TD></TR></TABLE>>];
"subject_section_lecturers" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#16324f"><FONT COLOR="white"><B>subject_section_lecturers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="10">PK id : bigint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="subject_section_id"><FONT POINT-SIZE="10">FK subject_section_id : bigint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lecturer_code"><FONT POINT-SIZE="10">lecturer_code : varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lecturer_name"><FONT POINT-SIZE="10">lecturer_name : varchar(70)</FONT></TD></TR></TABLE>>];
"subject_sections" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#16324f"><FONT COLOR="white"><B>subject_sections</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="10">PK id : bigint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="subject_id"><FONT POINT-SIZE="10">FK subject_id : bigint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="section"><FONT POINT-SIZE="10">section : varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="schedule_text"><FONT POINT-SIZE="10">schedule_text : varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="schedule"><FONT POINT-SIZE="10">schedule : json</FONT></TD></TR></TABLE>>];
"subjects" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD BGCOLOR="#16324f"><FONT COLOR="white"><B>subjects</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="10">PK id : bigint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="subject_code"><FONT POINT-SIZE="10">subject_code : varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="subject_name"><FONT POINT-SIZE="10">subject_name : varchar(255)</FONT></TD></TR></TABLE>>];
"subject_sections":"id" -> "subject_section_lecturers":"subject_section_id" [arrowhead=crow,arrowtail=tee,dir=both];
"subjects":"id" -> "subject_sections":"subject_id" [arrowhead=crow,arrowtail=tee,dir=both];
}